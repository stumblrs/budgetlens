# Cloudflare Account & Resource Identifiers (keep real values out of git; fill after `cf auth login`)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Three Free-Tier Cloudflare D1 Databases (< 500 MB each)
D1_BUDGETS_ID=
D1_LEDGERS_ID=
D1_APP_ID=

# Frontend API Base (leave empty when Worker serves API + Static Assets from the same origin)
VITE_API_BASE_URL=
