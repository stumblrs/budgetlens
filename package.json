{
  "name": "budget-lens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ui": "tsc -b && vite build --mode ui",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "cf:dev": "node ./node_modules/@cloudflare/vite-plugin/bin/cf-vite dev --local",
    "cf:build": "node ./node_modules/@cloudflare/vite-plugin/bin/cf-vite build",
    "cf:deploy": "cf deploy",
    "d1:seed:local": "python scripts/seed_cloudflare_d1.py --local",
    "d1:seed:remote-init": "python scripts/seed_cloudflare_d1.py --remote-init"
  },
  "dependencies": {
    "docx": "^9.16.0",
    "hono": "^4.13.22",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.26.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
